# ============================================================
# PFD Editor · 环境变量样例
#   用法：复制为 .env 并按需修改；或在启动前注入环境变量。
#   注意：server.js 是零依赖设计，不解析 .env 文件本身。
#         请通过 systemd Environment= / docker-compose environment /
#         shell 的 export 等方式注入（见 README「快速开始」）。
# ============================================================

# ---- 服务监听 ----
# 监听端口，默认 8090
PORT=8090
# 监听地址，默认 127.0.0.1（仅本机可访问，安全默认值）
# 需要局域网或容器访问时设为 0.0.0.0 —— 此时务必同时设置 PFD_API_TOKEN
HOST=127.0.0.1

# ---- 后端传感器 API ----
# server.js 会把 /api/* 反向代理到这个地址，默认 http://192.168.1.78
API_TARGET=http://192.168.1.78

# ---- 项目库 ----
# 项目 JSON 存放目录，默认 <项目根>/projects
PROJECT_DIR=

# ---- 访问控制 ----
# 项目库接口（/pfd-api/projects）访问令牌。留空 = 不鉴权。
# 设置后所有该前缀请求必须携带 X-PFD-Token 头；
# 令牌会由 server.js 自动注入到 HTML 页面，编辑器/预览页无需人工配置，
# 但直接调用 API 的脚本需要自行携带该头。
# 生成建议：openssl rand -hex 24
PFD_API_TOKEN=
