# ============================================================
# PFD Editor · 环境变量样例
#   用法：复制为 .env 并按需修改；或在启动前注入环境变量。
#   注意：server.js 是零依赖设计，不解析 .env 文件本身。
#         请通过 systemd Environment= / docker-compose environment /
#         shell 的 export 等方式注入（见 README「快速开始」）。
# ============================================================

# ---- 服务监听 ----
# 监听端口，默认 8090
PORT=8090
# 监听地址，默认 127.0.0.1（仅本机可访问，安全默认值）
# 需要局域网或容器访问时设为 0.0.0.0 —— 此时务必同时设置 PFD_API_TOKEN
HOST=127.0.0.1

# ---- 后端传感器 API ----
# server.js 会把 /api/* 反向代理到这个地址，默认 http://192.168.1.78
API_TARGET=http://192.168.1.78

# ---- 项目库 ----
# 项目 JSON 存放目录，默认 <项目根>/projects
PROJECT_DIR=

# ---- 访问控制 / 来源白名单 ----
# 项目库接口（/pfd-api/projects）访问令牌。留空 = 不鉴权。
# 设置后所有该前缀请求必须携带 X-PFD-Token 头；
# 令牌会由 server.js 自动注入到 HTML 页面，编辑器/预览页无需人工配置，
# 但直接调用 API 的脚本需要自行携带该头。
# 生成建议：openssl rand -hex 24
PFD_API_TOKEN=

# 允许跨域访问 /api/* 的来源白名单（逗号分隔）。留空 = 不开放跨域（仅同源可用）。
# 编辑器与预览页和 API 同源，本身不需要此项；仅当别的站点要直接调本代理时才需配置。
# 例：PFD_CORS_ORIGINS=https://ops.example,https://bi.example
PFD_CORS_ORIGINS=

# 允许把预览页嵌入 iframe 的宿主来源白名单（逗号分隔）。留空 = 仅同源可嵌入。
# 配置后会自动省略 X-Frame-Options（避免与 CSP frame-ancestors 叠加导致嵌入失效），
# 预览页同时用它校验 postMessage 来源。
# 例：PFD_EMBED_ORIGINS=https://portal.example
PFD_EMBED_ORIGINS=

# 允许通过 ?api= 覆盖后端地址的跨源白名单（逗号分隔）。留空 = 只允许同源（推荐）。
# 用于本地开发时把编辑器指向另一套后端；不登记则 ?api= 的跨源取值会被忽略。
# 例：PFD_API_ALLOW=http://127.0.0.1:8080
PFD_API_ALLOW=

# ---- 代理限流 ----

# 上游请求超时（毫秒），默认 15000
PFD_PROXY_TIMEOUT_MS=15000
# /api/* 请求体上限（字节），默认 2097152（2MB）
PFD_API_MAX_BYTES=2097152
# 项目库请求体上限（字节），默认 10485760（10MB）
PFD_PROJECT_MAX_BYTES=10485760
